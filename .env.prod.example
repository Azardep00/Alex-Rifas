# Variables del perfil prod (CP-20). Cópialas al panel del host (Render > Environment), NO a un archivo en Git.
SPRING_PROFILES_ACTIVE=prod

# --- Postgres externo (formato JDBC, con SSL) ---
DB_URL=jdbc:postgresql://HOST:5432/NOMBRE_BD?sslmode=require
DB_USERNAME=usuario
DB_PASSWORD=clave

# --- Seguridad ---
# Mínimo 32 caracteres:  openssl rand -base64 48
JWT_SECRET=
# Se crea al arrancar si aún no existe ningún admin. Contraseña de 10+ caracteres.
ADMIN_CORREO=
ADMIN_CONTRASENA=

# --- Opcionales ---
# Redis (antiabuso por IP + caché de la grilla). Sin Redis la API funciona igual.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
HEALTH_REDIS_ENABLED=false
# Saltos de proxy para la IP real del cliente (Vercel -> host -> API = 2).
ANTIABUSO_SALTOS_PROXY=2
DB_POOL_MAX=5
