# Copia este archivo a ".env" y cambia TODOS los valores antes de levantar el stack:
#     cp .env.example .env
# El archivo .env está en .gitignore: nunca se sube a GitHub.

# --- Docker Hub (usuario con el que se publican/descargan las imágenes) ---
DOCKERHUB_USER=tu_usuario_dockerhub
TAG=latest

# --- Puerto público del proxy (único puerto expuesto al exterior) ---
HTTP_PORT=80

# --- PostgreSQL ---
POSTGRES_DB=alexrifas
POSTGRES_USER=alexrifas
POSTGRES_PASSWORD=cambia-esta-clave-postgres

# --- Redis ---
REDIS_PASSWORD=cambia-esta-clave-redis

# --- MongoDB ---
# Evita los caracteres @ : / ? # en la contraseña: va dentro de una URL de conexión.
MONGO_USER=alexrifas
MONGO_PASSWORD=cambia-esta-clave-mongo

# --- Backend (Spring Boot) ---
# Mínimo 32 caracteres. Genera uno con:  openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-jwt-de-al-menos-32-caracteres
# Si ambos están definidos y no existe ningún admin, se crea al arrancar (disponible desde la Tarea 3).
ADMIN_CORREO=admin@alexrifas.local
ADMIN_CONTRASENA=cambia-esta-clave-admin
